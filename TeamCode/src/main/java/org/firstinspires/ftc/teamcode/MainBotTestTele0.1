package org.firstinspires.ftc.teamcode;
import com.qualcomm.robotcore.eventloop.opmode.Disabled;
import com.qualcomm.robotcore.hardware.Servo;
import org.firstinspires.ftc.robotcore.external.hardware.camera.CameraCompatibilityManager;
import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;

@TeleOp(name = "MainBotTest0.1")
public class MainBotTest01 extends LinearOpMode {

    private DcMotor flyWheel;
    private DcMotor frontLeft;
    private DcMotor backLeft;
    private DcMotor frontRight;
    private DcMotor backRight;
    private DcMotor midIntake;
//    private DcMotor mainIntake;
    private Servo stopper;

    @Override
    public void runOpMode() {

        double Strafe = 0;
        float Drive = 0;
        float Rotate = 0;

// Init

        frontLeft = hardwareMap.get(DcMotor.class, "frontLeft");
        backLeft = hardwareMap.get(DcMotor.class, "backLeft");
        frontRight = hardwareMap.get(DcMotor.class, "frontRight");
        backRight = hardwareMap.get(DcMotor.class, "backRight");
        flyWheel = hardwareMap.get(DcMotor.class, "flyWheel");
        stopper = hardwareMap.get(Servo.class, "stopper");
        midIntake = hardwareMap.get(DcMotor.class, "midIntake");

  //      Only use main intake if we add a motor to the front intake
  //      mainIntake = hardwareMap.get(DcMotor.class, "mainIntake"); 


        waitForStart();
        if (opModeIsActive()) {
            while (opModeIsActive()) {
                frontLeft.setPower(Strafe * 1 + Drive * 1 + Rotate * 1);
                backLeft.setPower(Strafe * 1 + Drive * 1 + Rotate * -1);
                frontRight.setPower(Strafe * 1 + Drive * -1 + Rotate * 1);
                backRight.setPower(Strafe * 1 + Drive * -1 + Rotate * -1);
                Drive = gamepad1.left_stick_y * 1;
                Rotate = gamepad1.left_stick_x * 1;
                Strafe = gamepad1.right_stick_x * 1;

                // Fly Wheel controls (Dpad up, Dpad down)
                if (gamepad1.dpad_up) {
                    flyWheel.setPower(1); // Powered flywheel 
                    midIntake.setPower(1); // Fast intake
                    stopper.setPosition(0.5); // Open Pos
                }
                if (gamepad1.dpad_down) {
                    flyWheel.setPower(-0.01); // This is like this because it dosent stop fast enough on bot
                    midIntake.setPower(0.7); // Slower intake
                    stopper.setPosition(0.91); // Closed Pos
                }

                // Front Intake Controls

                if (gamepad1.right_bumper) { // intaking balls should be norm setting
      //              mainIntake.setPower(1);
                    midIntake.setPower(1);
                } 
                if (gamepad1.left_bumper) { // Remove balls
      //              mainIntake.setPower(-1);
                    midIntake.setPower(-1); //Reverse
                }
        //       if (gamepad1.dpad_left) {
        //            stopper.setPosition(0.91);
        //        }
         //       if (gamepad1.dpad_right) {
          //          stopper.setPosition(0.5);
        //        }
        telemetry.update();
        telemetry.addData("Servo Position", stopper.getPosition());
    }
}
}
}
